# AirWise AI - Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API Key (Backend Only - NEVER expose to client)
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom API Base URLs (Defaults to Open-Meteo free endpoints)
AIR_QUALITY_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# Frontend Configuration (for production deployment)
VITE_API_URL=http://localhost:5000/api
